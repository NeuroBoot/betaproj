# ==============================================================================
# FACEMARK SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env'
# 2. Update the values below to match your local setup.
# 3. DO NOT commit the actual '.env' file to source control.
# ==============================================================================

# --- APPLICATION SETTINGS ---
# Environment: development, production, test
NODE_ENV=development
# The port the server will listen on
PORT=3000

# --- DATABASE SETTINGS (MySQL) ---
# Database host (usually localhost for local development)
DB_HOST=localhost
# Database port (default MySQL port is 3306)
DB_PORT=3306
# Database username
DB_USERNAME=root
# Database password (leave empty if no password is set)
DB_PASSWORD=yourpassword
# The name of the database to use
DB_NAME=facemark
# IMPORTANT: set to 'true' only for the FIRST run to create tables.
# Change to 'false' afterwards to prevent accidental data loss.
DB_SYNCHRONIZE=true

# --- JWT AUTHENTICATION SETTINGS ---
# Secret key used for signing JWT tokens (use a long, random string in production)
JWT_SECRET=your_super_secret_key_here
# Token expiration time (e.g., 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# --- CORS SETTINGS (Optional) ---
# Allowed origins for frontend (comma-separated)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }] },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"studentId\": 3,\n  \"courseId\": 1,\n  \"staffId\": 2,\n  \"attendanceStatusId\": 1,\n  \"recordDate\": \"2024-03-20T10:00:00Z\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/attendance", "host": ["{{baseUrl}}"], "path": ["api", "v1", "attendance"] }
					}
				},
				{
					"name": "Attendance Statistics (Admin/Staff Only)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var template = `",
									"    <canvas id=\"myChart\" style=\"max-width: 400px; margin: auto;\"></canvas>",
									"    <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>",
									"    <script>",
									"        var response = pm.response.json();",
									"        var labels = response.data.map(item => item.status);",
									"        var counts = response.data.map(item => item.count);",
									"",
									"        new Chart(\"myChart\", {",
									"            type: \"pie\",",
									"            data: {",
									"                labels: labels,",
									"                datasets: [{",
									"                    backgroundColor: [\"#2ecc71\", \"#e74c3c\", \"#f1c40f\", \"#3498db\"],",
									"                    data: counts",
									"                }]",
									"            },",
									"            options: {",
									"                title: { display: true, text: \"Attendance Distribution\" }",
									"            }",
									"        });",
									"    </script>",
									"`;",
									"",
									"pm.visualizer.set(template);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{bearerToken}}", "type": "string" }] },
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/api/v1/attendance/statistics", "host": ["{{baseUrl}}"], "path": ["api", "v1", "attendance", "statistics"] }
					}
				}
			]

{
	"info": {
		"name": "Attendance Master Collection",
		"description": "FaceMark Full API. Fixed for {{base_url}} and {{token}} with Student Analytics restored.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"ziad_taha\",\n  \"password\": \"password123\"\n}"
						},
						"url": "{{base_url}}/auth/login"
					}
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_url}}/auth/profile"
					}
				}
			]
		},
		{
			"name": "2. Student Analytics",
			"item": [
				{
					"name": "Get Attendance Diagram",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_url}}/student/charts"
					}
				},
				{
					"name": "Get Student Alerts",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_url}}/student/alerts"
					}
				}
			]
		},
		{
			"name": "3. Course Management",
			"item": [
				{
					"name": "Enroll Student",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"studentId\": 1,\n  \"section\": \"S1\",\n  \"lecture\": \"L1\"\n}"
						},
						"url": "{{base_url}}/courses/1/students"
					}
				},
				{
					"name": "List Courses",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_url}}/courses"
					}
				}
			]
		},
		{
			"name": "4. Attendance Tracking",
			"item": [
				{
					"name": "Save Bulk Attendance",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"courseId\": \"1\",\n  \"section\": \"1\",\n  \"date\": \"2026-04-25\",\n  \"attendance\": [\n    { \"studentId\": \"1\", \"status\": \"Present\" }\n  ]\n}"
						},
						"url": "{{base_url}}/attendance"
					}
				},
				{
					"name": "List Attendance",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_url}}/attendance?courseId=1"
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "base_url", "value": "http://localhost:3000/api/v1" },
		{ "key": "token", "value": "PASTE_TOKEN_HERE" }
	]
}

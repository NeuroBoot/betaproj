{
  "openapi": "3.0.0",
  "info": {
    "title": "Attendance System Pro - Intelligent Engine",
    "version": "3.2.0",
    "description": "API documentation featuring Intelligent Student Tracking, Risk Analysis, and Targeted Admin Alerts."
  },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/alerts/send/{userId}": {
      "post": {
        "tags": ["Alerts"],
        "summary": "Send targeted alert to a student",
        "parameters": [{ "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string" },
                  "title": { "type": "string" },
                  "type": { "type": "string", "enum": ["info", "warning", "danger"] },
                  "metadata": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "Alert sent" } }
      }
    },
    "/attendance/track/{studentId}": {
      "get": {
        "tags": ["Attendance"],
        "summary": "Intelligent Risk & Trend Analysis",
        "parameters": [
          { "name": "studentId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "courseId", "in": "query", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Returns Risk Level and Trend Analysis" } }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Register a new user (Restores if soft-deleted)",
        "responses": { "201": { "description": "User created or restored" } }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Authentication"],
        "summary": "Login to get JWT token",
        "responses": { "200": { "description": "Token issued" } }
      }
    },
    "/users": {
      "get": { "tags": ["Users"], "summary": "List all users (Admin only)" },
      "post": { 
        "tags": ["Users"], 
        "summary": "Create new user (Restores if soft-deleted)",
        "responses": { "201": { "description": "User created or restored" } }
      }
    },
    "/courses": {
      "get": { "tags": ["Courses"], "summary": "List active courses" },
      "post": { 
        "tags": ["Courses"], 
        "summary": "Create course (Restores if soft-deleted)",
        "responses": { "201": { "description": "Course created or restored" } }
      }
    },
    "/courses/{id}": {
      "delete": {
        "tags": ["Courses"],
        "summary": "Delete course by ID (Admins). Use ?hard=true for permanent.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "hard", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/courses/code/{code}": {
      "delete": {
        "tags": ["Courses"],
        "summary": "Delete course by Code (Admins). Use ?hard=true for permanent.",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "hard", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/users/{id}": {
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user by ID (Admins). Use ?hard=true for permanent.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "hard", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    },
    "/users/username/{username}": {
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user by Username (Admins). Use ?hard=true for permanent.",
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "hard", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": { "200": { "description": "Success" } }
      }
    }
    }
    }
